# ============ SERVER ============
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
PUBLIC_APP_URL=https://smartcontrol.pro
DOMAIN=smartcontrol.pro

# ============ FIREBASE ============
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_NUMBER=REPLACE_WITH_FIREBASE_PROJECT_NUMBER
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
FIREBASE_SERVICE_ACCOUNT_JSON={}

# ============ GOOGLE OAUTH ============
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_ROTATED_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ============ RAZORPAY ============
RAZORPAY_KEY_ID=REPLACE_AFTER_ROTATE
RAZORPAY_KEY_SECRET=REPLACE_WITH_ROTATED_SECRET
RAZORPAY_MODE=TEST
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ============ DATABASE ============
DATABASE_URL=postgresql://user:password@localhost:5432/smartcontrol
REDIS_URL=redis://localhost:6379

# ============ JWT ============
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# ============ TURN SERVER ============
TURN_SERVER_URL=turn:turn.smartcontrol.pro:3478
TURN_SERVER_USER=REPLACE_WITH_TURN_USER
TURN_SERVER_PASS=REPLACE_WITH_TURN_PASSWORD

# ============ MAPS ============
MAPBOX_TOKEN=REPLACE_WITH_MAPBOX_TOKEN
GOOGLE_MAPS_API_KEY=REPLACE_WITH_MAPS_KEY

# ============ SMS/OTP ============
MSG91_AUTH_KEY=REPLACE_WITH_MSG91_KEY
MSG91_SENDER_ID=SMTRLP
DLT_TEMPLATE_ID=REPLACE_WITH_DLT_ID

# ============ MONITORING ============
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
LOG_LEVEL=info

# ============ SECURITY ============
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
CORS_ORIGINS=http://localhost:3001,https://smartcontrol.pro

# ============ APP CONFIG (Runtime — User sets in Settings) ============
OWNER_EMAIL_PLACEHOLDER={{OWNER_EMAIL}}
OWNER_PHONE_PLACEHOLDER={{OWNER_PHONE}}
SUPPORT_EMAIL_PLACEHOLDER={{SUPPORT_EMAIL}}
SUPPORT_PHONE_PLACEHOLDER={{SUPPORT_PHONE}}
