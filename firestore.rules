rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /parentSecurity/{uid} {
   allow read, write: if request.auth != null && request.auth.uid == uid;
  }
  match /devices/{uid} {
   allow read, write: if request.auth != null && request.auth.uid == uid;
   match /statusAlerts/{alertId} {
    allow read, write: if request.auth != null && request.auth.uid == uid;
   }
 }
}
